---
// Thin scroll-progress indicator pinned to the top of the viewport.
// Rendered only on article pages.
---
<div id="reading-progress" aria-hidden="true"></div>

<style>
  #reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2.5px;
    z-index: 30;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #fff));
    transform: scaleX(0);
    transform-origin: 0 50%;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    #reading-progress {
      transition: none;
    }
  }
</style>

<script>
  // One global listener (guarded), recomputing the current article each tick so
  // it keeps working across View Transitions without stacking listeners.
  if (!(window as any).__progressBound) {
    (window as any).__progressBound = true;
    let ticking = false;
    const paint = () => {
      ticking = false;
      const bar = document.getElementById('reading-progress');
      if (!bar) return;
      const article = document.querySelector<HTMLElement>('article.prose');
      const end =
        (article ? article.offsetTop + article.offsetHeight : document.documentElement.scrollHeight) -
        window.innerHeight;
      const p = end > 0 ? Math.min(1, Math.max(0, window.scrollY / end)) : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    document.addEventListener('astro:page-load', paint);
  }
</script>
