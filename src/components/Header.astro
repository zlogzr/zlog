---
import { withBase } from '../lib/url';
import { NAV } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (p: string) =>
  path === withBase(p) || path.startsWith(withBase(p) + '/');
---

<header id="site-header" transition:persist="site-header">
  <div class="wrap bar">
    <a href={withBase('/')} class="brand" aria-label="回到首页">
      <span class="prompt">~/</span>zlog<span class="caret" aria-hidden="true"></span>
    </a>

    <nav class="nav" aria-label="主导航">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}

      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅色主题" title="切换主题">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <line x1="12" y1="2.5" x2="12" y2="5" />
            <line x1="12" y1="19" x2="12" y2="21.5" />
            <line x1="2.5" y1="12" x2="5" y2="12" />
            <line x1="19" y1="12" x2="21.5" y2="12" />
            <line x1="5.1" y1="5.1" x2="6.9" y2="6.9" />
            <line x1="17.1" y1="17.1" x2="18.9" y2="18.9" />
            <line x1="5.1" y1="18.9" x2="6.9" y2="17.1" />
            <line x1="17.1" y1="6.9" x2="18.9" y2="5.1" />
          </g>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a0.5 0.5 0 0 0-.7-.6A9 9 0 1 0 20.6 15.2a0.5 0.5 0 0 0-.6-.7Z"
            fill="currentColor"
          />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  header.scrolled {
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .brand {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--text);
    display: inline-flex;
    align-items: center;
  }
  .brand:hover {
    color: var(--text);
  }
  .brand .prompt {
    color: var(--accent);
  }
  .brand .caret {
    width: 8px;
    height: 1.05em;
    margin-left: 3px;
    background: var(--accent);
    border-radius: 1px;
    opacity: 0;
    transform: translateY(1px);
    animation: blink 1.2s steps(1) infinite;
  }
  .brand:hover .caret {
    opacity: 1;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 3vw, 1.3rem);
  }
  .nav-link {
    position: relative;
    color: var(--text-soft);
    font-size: var(--step-0);
    padding-block: 4px;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link.active {
    color: var(--text);
    font-weight: 600;
  }
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: 0.2rem;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }
  .icon-btn:hover {
    color: var(--accent);
    background: var(--bg-subtle);
    border-color: var(--border);
  }
  .icon-btn svg {
    grid-area: 1 / 1;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  /* Show the icon for the theme you'd switch TO. */
  :root[data-theme='dark'] .i-sun,
  :root:not([data-theme='dark']) .i-moon {
    opacity: 0;
    transform: scale(0.4) rotate(-40deg);
  }
  :root[data-theme='dark'] .i-moon,
  :root:not([data-theme='dark']) .i-sun {
    opacity: 1;
    transform: none;
  }

  /* Keep the bar on one line on small screens (no overflow → no page scroll). */
  @media (max-width: 480px) {
    .brand {
      font-size: 1rem;
    }
    .brand .caret {
      display: none;
    }
    .nav {
      gap: 0.55rem;
    }
    .nav-link {
      font-size: 0.92rem;
    }
    .icon-btn {
      width: 30px;
      height: 30px;
      margin-left: 0.05rem;
    }
  }
</style>

<script>
  // The header is transition:persist'd, so its server-rendered state carries
  // across client navigations and won't update on its own. Re-sync the two
  // things that depend on the current page/scroll after every navigation.
  if (!(window as any).__headerBound) {
    (window as any).__headerBound = true;

    const onScroll = () => {
      document
        .getElementById('site-header')
        ?.classList.toggle('scrolled', window.scrollY > 8);
    };

    // Highlight the nav link matching the current URL. hrefs already include
    // the base path; pathname does too, so they compare directly. Trailing
    // slash is handled by the startsWith branch.
    const syncActiveNav = () => {
      const path = location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll<HTMLAnchorElement>('#site-header .nav-link').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
        const active = href !== '/' && (path === href || path.startsWith(href + '/'));
        a.classList.toggle('active', active);
        if (active) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
    };

    onScroll();
    syncActiveNav();
    window.addEventListener('scroll', onScroll, { passive: true });
    // astro:page-load fires on initial load and after each view transition.
    document.addEventListener('astro:page-load', () => {
      onScroll();
      syncActiveNav();
    });
  }
</script>
