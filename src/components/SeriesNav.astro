---
import { withBase } from '../lib/url';
import type { Series, Entry } from '../lib/collections';

interface Props {
  series: Series;
  currentId: string;
  /** 0-based index of the current entry within the series. */
  index: number;
}
const { series, currentId, index } = Astro.props;
const total = series.items.length;
const seriesHref = withBase(`/series/${encodeURIComponent(series.name)}`);
---
<aside class="series" aria-label={`系列：${series.name}`}>
  <details open>
    <summary>
      <span class="series-eyebrow mono">// 本文属于系列</span>
      <span class="series-name">
        <a href={seriesHref}>{series.name}</a>
        <span class="series-pos mono">{index + 1} / {total}</span>
      </span>
    </summary>
    <ol class="series-list">
      {series.items.map((item: Entry, i: number) => (
        <li class:list={['series-item', { current: item.id === currentId }]}>
          <span class="series-idx mono">{String(i + 1).padStart(2, '0')}</span>
          {item.id === currentId ? (
            <span class="series-cur" aria-current="true">{item.title}</span>
          ) : (
            <a href={item.href}>{item.title}</a>
          )}
        </li>
      ))}
    </ol>
  </details>
</aside>

<style>
  .series {
    margin-bottom: var(--space-6);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-soft);
    padding: 0.85rem 1.05rem;
  }
  details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .series-eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
  }
  .series-name {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: var(--step-1);
  }
  .series-name a {
    color: var(--text);
  }
  .series-name a:hover {
    color: var(--accent);
  }
  .series-pos {
    color: var(--text-faint);
    font-size: var(--step--1);
    font-weight: 400;
  }
  .series-list {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .series-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.3rem 0.4rem;
    margin: 0 -0.4rem;
    border-radius: var(--radius-sm);
    font-size: var(--step-0);
  }
  .series-idx {
    color: var(--text-faint);
    font-size: 0.72rem;
    flex-shrink: 0;
  }
  .series-item a {
    color: var(--text-soft);
  }
  .series-item a:hover {
    color: var(--accent);
  }
  .series-item.current {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .series-cur {
    font-weight: 600;
    color: var(--text);
  }
</style>
