---
// Global Cmd/Ctrl+K quick search. Reuses Pagefind (built into /pagefind at
// build time). Lazy-loads the Pagefind UI on first open, so pages ship nothing
// extra until invoked. Opened by ⌘K or any [data-open-search] button.
import { withBase } from '../lib/url';

const cssHref = withBase('/pagefind/pagefind-ui.css');
const jsSrc = withBase('/pagefind/pagefind-ui.js');
const bundlePath = withBase('/pagefind/');
---
<link rel="stylesheet" href={cssHref} />
<dialog id="search-dialog" class="search-dialog" aria-label="站内搜索">
  <div class="sd-inner">
    <div class="sd-head">
      <span class="sd-hint mono">搜索博客与知识库</span>
      <kbd class="sd-esc mono">Esc</kbd>
    </div>
    <div id="search-modal"></div>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    width: min(640px, 92vw);
    margin-top: 12vh;
    margin-inline: auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--text);
    box-shadow: var(--shadow-md, 0 20px 50px rgba(0, 0, 0, 0.25));
  }
  .search-dialog::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, rgba(0, 0, 0, 0.5));
    backdrop-filter: blur(3px);
  }
  .search-dialog .sd-inner {
    padding: 1rem 1.1rem 1.2rem;
  }
  .search-dialog .sd-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .search-dialog .sd-esc {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.4rem;
    background: var(--bg-subtle);
  }
  .search-dialog .pagefind-ui {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-sans);
  }
</style>

<script is:inline define:vars={{ jsSrc, bundlePath }}>
  (function () {
    if (window.__searchModalBound) return;
    window.__searchModalBound = true;

    let inited = false;
    const dialog = () => document.getElementById('search-dialog');

    function initPagefind(cb) {
      if (inited) return cb && cb();
      const run = () => {
        new window.PagefindUI({
          element: '#search-modal',
          bundlePath: bundlePath,
          showImages: false,
          showSubResults: true,
          excerptLength: 15,
          translations: {
            placeholder: '搜索知识库与博客…',
            clear_search: '清除',
            load_more: '加载更多结果',
            search_label: '站内搜索',
            zero_results: '没有找到关于「[SEARCH_TERM]」的内容',
            many_results: '找到 [COUNT] 条关于「[SEARCH_TERM]」的结果',
            one_result: '找到 [COUNT] 条关于「[SEARCH_TERM]」的结果',
            searching: '正在搜索「[SEARCH_TERM]」…',
          },
        });
        inited = true;
        cb && cb();
      };
      if (window.PagefindUI) run();
      else {
        const s = document.createElement('script');
        s.src = jsSrc;
        s.onload = run;
        document.head.appendChild(s);
      }
    }

    function open() {
      const d = dialog();
      if (!d) return;
      initPagefind(() => {
        setTimeout(() => {
          const input = d.querySelector('.pagefind-ui__search-input');
          if (input) input.focus();
        }, 60);
      });
      if (!d.open) d.showModal();
    }

    window.__openSearch = open;

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        const d = dialog();
        if (d && d.open) d.close();
        else open();
      }
    });

    // Any button can open it.
    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-open-search]')) {
        e.preventDefault();
        open();
      }
    });

    // Click on the backdrop (outside the inner panel) closes.
    document.addEventListener('click', (e) => {
      const d = dialog();
      if (d && d.open && e.target === d) d.close();
    });

    // Clicking a result navigates — close the dialog in the capture phase, i.e.
    // before the router (a bubble-phase listener) snapshots the page, so the
    // open modal never appears over the destination.
    document.addEventListener(
      'click',
      (e) => {
        const d = dialog();
        if (d && d.open && e.target.closest && e.target.closest('#search-dialog a')) d.close();
      },
      true,
    );

    // The dialog is NOT persisted across View Transitions: an open modal in the
    // top layer would bleed over the next page. Close it before any swap, and
    // re-init Pagefind on the fresh (recreated) dialog after navigating.
    document.addEventListener('astro:before-swap', () => {
      const d = dialog();
      if (d && d.open) d.close();
    });
    document.addEventListener('astro:after-swap', () => {
      inited = false;
    });
  })();
</script>
