---
// Renders any `pre.mermaid` blocks (emitted by remark-mermaid) to SVG on the
// client. Mermaid is dynamically imported only when a diagram is present, so
// pages without diagrams ship zero extra JS. Bundled locally — no CDN — so it
// works offline and 国内可访问. Re-renders on theme switch.
---
<script>
  let mermaid: any = null;
  const sources = new WeakMap<Element, string>();

  const theme = () =>
    document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';

  async function render() {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));
    if (!blocks.length) return;

    if (!mermaid) {
      mermaid = (await import('mermaid')).default;
    }
    // Cache each diagram's source once; mermaid replaces the element's content
    // with SVG, so we need the original text to re-render on theme change.
    for (const el of blocks) {
      if (!sources.has(el)) sources.set(el, el.textContent || '');
      el.innerHTML = sources.get(el)!;
      el.removeAttribute('data-processed');
    }

    mermaid.initialize({
      startOnLoad: false,
      theme: theme(),
      // Diagram source is the site owner's own trusted build-time markdown
      // (never user input), so 'loose' is safe here and lets <br/> in labels
      // render as line breaks.
      securityLevel: 'loose',
      fontFamily: 'inherit',
    });

    try {
      await mermaid.run({ nodes: blocks });
    } catch {
      /* On parse error, the readable source stays visible. */
    }
  }

  document.addEventListener('astro:page-load', render);
  window.addEventListener('theme-change', () => render());
</script>
