---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, tagUrl } from '../lib/url';
import { formatDate } from '../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Group posts by year, newest first.
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---
<BaseLayout title="归档" description="按时间倒序纵览全部文章。">
  <div class="page-head">
    <p class="eyebrow mono">// archive</p>
    <h1>归档</h1>
    <p class="lede">
      按时间倒序的全部文章，共 {posts.length} 篇。知识库笔记按主题整理在
      <a href={withBase('/notes')}>知识库</a>，也可顺着<a href={withBase('/series')}>系列</a>读。
    </p>
  </div>

  {years.map(([year, items]) => (
    <section class="year" data-reveal>
      <h2 class="year-title"><span class="mono">{year}</span><span class="year-count">{items.length} 篇</span></h2>
      <ul class="list">
        {items.map((p) => (
          <li class="row">
            <a class="row-link" href={withBase(`/posts/${p.id}`)}>
              <time class="row-date mono" datetime={p.data.date.toISOString()}>
                {formatDate(p.data.date).slice(5)}
              </time>
              <span class="row-title">{p.data.title}</span>
            </a>
            {p.data.tags.length > 0 && (
              <div class="row-tags">
                {p.data.tags.slice(0, 3).map((t) => <a class="tag" href={tagUrl(t)}>{t}</a>)}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .year {
    margin-bottom: var(--space-6);
  }
  .year-title {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--step-2);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
    margin: 0 0 0.4rem;
  }
  .year-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.6rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: var(--radius);
    transition: background var(--dur-fast) var(--ease);
  }
  .row:hover {
    background: var(--bg-subtle);
  }
  .row-link {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    color: var(--text);
    min-width: 0;
    flex: 1;
  }
  .row-date {
    flex-shrink: 0;
    color: var(--text-faint);
    font-size: var(--step--1);
    width: 3.2em;
  }
  .row-title {
    font-weight: 500;
  }
  .row-link:hover .row-title {
    color: var(--accent);
  }
  .row-tags {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  @media (max-width: 520px) {
    .row-tags {
      display: none;
    }
  }
</style>
