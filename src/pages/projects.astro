---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../lib/projects';

// Featured first, otherwise keep authored order.
const projects = [...PROJECTS].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false),
);

const statusClass: Record<string, string> = {
  在线: 'live',
  开源: 'oss',
  已上线: 'shipped',
  内部项目: 'internal',
};
---
<BaseLayout
  title="作品集"
  description="精选项目 —— 电商前台、可视化编辑器、设计系统与前端工程化。重在角色、技术选型与解决的核心问题。"
>
  <div class="page-head">
    <p class="eyebrow mono">// projects</p>
    <h1>作品集</h1>
    <p class="lede">
      这些年做过、还在做的一些事。比起罗列功能，我更想说清楚每个项目里我承担了什么角色、
      为什么这么选型、又啃下了哪块硬骨头。部分条目已做脱敏处理。
    </p>
  </div>

  <div class="projects">
    {projects.map((p) => (
      <article class="project" data-reveal>
        <div class="p-head">
          <div class="p-title">
            <h2>{p.name}</h2>
            <span class:list={['status', statusClass[p.status]]}>{p.status}</span>
          </div>
          <span class="p-period mono">{p.period}</span>
        </div>

        <p class="p-tagline">{p.tagline}</p>
        <p class="p-desc">{p.description}</p>

        <p class="p-role"><span class="label">角色</span>{p.role}</p>

        <ul class="p-highlights">
          {p.highlights.map((h) => <li>{h}</li>)}
        </ul>

        <div class="p-foot">
          <ul class="p-stack">
            {p.stack.map((s) => <li class="chip mono">{s}</li>)}
          </ul>
          {p.links && p.links.length > 0 && (
            <div class="p-links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: 1.2rem;
  }
  .project {
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .p-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .p-title {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .p-title h2 {
    margin: 0;
    font-size: var(--step-2);
  }
  .status {
    flex-shrink: 0;
    font-size: 0.7rem;
    line-height: 1.7;
    padding: 0 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    color: var(--text-soft);
    background: var(--bg-subtle);
  }
  .status.live {
    color: #16a34a;
    border-color: color-mix(in srgb, #16a34a 40%, var(--border));
    background: color-mix(in srgb, #16a34a 10%, transparent);
  }
  .status.oss {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: var(--accent-soft);
  }
  .p-period {
    flex-shrink: 0;
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .p-tagline {
    margin: 0.5rem 0 0;
    color: var(--accent);
    font-size: var(--step-0);
    font-weight: 550;
  }
  .p-desc {
    margin: 0.5rem 0 0;
    color: var(--text-soft);
    line-height: 1.8;
  }
  .p-role {
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .p-role .label {
    display: inline-block;
    margin-right: 0.6rem;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .p-highlights {
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }
  .p-highlights li {
    color: var(--text-soft);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .p-highlights li::marker {
    color: var(--accent);
  }
  .p-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .p-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .p-stack .chip {
    font-size: 0.72rem;
    color: var(--text-soft);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.5rem;
  }
  .p-links {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }
  .p-links a {
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 550;
  }
</style>
