---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllEntries } from '../lib/collections';

const entries = await getAllEntries();
const byId = new Map(entries.map((e) => [e.id, e]));

// Undirected edges from `related` (deduped). Both endpoints must exist.
const edgeSet = new Set<string>();
const edges: { a: string; b: string }[] = [];
for (const e of entries) {
  for (const rel of e.related) {
    if (!byId.has(rel)) continue;
    const key = [e.id, rel].sort().join('::');
    if (edgeSet.has(key)) continue;
    edgeSet.add(key);
    edges.push({ a: e.id, b: rel });
  }
}

// Only graph connected nodes — isolated dots add noise.
const connected = new Set<string>();
for (const { a, b } of edges) {
  connected.add(a);
  connected.add(b);
}
const degree = new Map<string, number>();
for (const { a, b } of edges) {
  degree.set(a, (degree.get(a) ?? 0) + 1);
  degree.set(b, (degree.get(b) ?? 0) + 1);
}

const nodes = entries
  .filter((e) => connected.has(e.id))
  .map((e) => ({
    id: e.id,
    title: e.title,
    href: e.href,
    group: e.kind === 'post' ? '文章 / 思考' : e.category ?? '其它',
    degree: degree.get(e.id) ?? 0,
  }));

const groups = [...new Set(nodes.map((n) => n.group))].sort((a, b) => a.localeCompare(b, 'zh'));
const graph = { nodes, edges };
---
<BaseLayout
  title="知识图谱"
  description="把知识库与文章按相互引用连成一张图，看见知识之间的关系。"
>
  <div class="page-head">
    <p class="eyebrow mono">// knowledge graph</p>
    <h1>知识图谱</h1>
    <p class="lede">
      节点是笔记与文章，连线是它们之间的引用关系。共 {nodes.length} 个节点、{edges.length} 条连线。
      悬停高亮邻居，点击进入。
    </p>
  </div>

  <ul class="legend" aria-label="分类图例">
    {groups.map((g, i) => (
      <li><span class="dot" data-group={g} style={`--i:${i}`}></span>{g}</li>
    ))}
  </ul>

  <div class="graph-wrap">
    <canvas id="graph-canvas" role="img" aria-label="知识图谱关系图"></canvas>
    <p class="nojs">图谱需要 JavaScript 才能显示。你也可以从<a href={import.meta.env.BASE_URL + 'notes'}>知识库</a>或<a href={import.meta.env.BASE_URL + 'series'}>系列</a>浏览。</p>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(graph)} />
</BaseLayout>

<style>
  .legend {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    /* same hue formula as the canvas renderer */
    background: hsl(calc(var(--i) * 47), 62%, 55%);
  }
  .graph-wrap {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  #graph-canvas {
    display: block;
    width: 100%;
    height: min(72vh, 640px);
    cursor: grab;
    touch-action: none;
  }
  #graph-canvas:active {
    cursor: grabbing;
  }
  .nojs {
    display: none;
    padding: var(--space-6);
    color: var(--text-soft);
    text-align: center;
  }
  html:not(.js) .nojs {
    display: block;
  }
  html:not(.js) #graph-canvas {
    display: none;
  }
</style>

<script>
  // Lightweight force-directed graph on canvas — no external libs, theme-aware,
  // works under View Transitions. Re-initialised on every page load.
  type N = {
    id: string; title: string; href: string; group: string; degree: number;
    x: number; y: number; vx: number; vy: number; r: number; color: string;
  };

  let raf = 0;
  let cleanup: (() => void) | null = null;

  function hueFor(groups: string[], g: string) {
    return (groups.indexOf(g) * 47) % 360;
  }

  function init() {
    const canvas = document.getElementById('graph-canvas') as HTMLCanvasElement | null;
    const dataEl = document.getElementById('graph-data');
    if (!canvas || !dataEl) return;

    if (cleanup) cleanup();
    cancelAnimationFrame(raf);

    const raw = JSON.parse(dataEl.textContent || '{"nodes":[],"edges":[]}');
    const groups = [...new Set(raw.nodes.map((n: any) => n.group))].sort((a: string, b: string) =>
      a.localeCompare(b, 'zh'),
    ) as string[];

    const ctx = canvas.getContext('2d')!;
    let W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);

    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    let colText = '', colFaint = '', colEdge = '', colCard = '';
    function readTheme() {
      colText = css('--text');
      colFaint = css('--text-faint');
      colEdge = css('--border-strong');
      colCard = css('--surface');
    }
    readTheme();

    const nodes: N[] = raw.nodes.map((n: any, i: number) => ({
      ...n,
      x: Math.cos(i) * 120 + (Math.random() - 0.5) * 40,
      y: Math.sin(i) * 120 + (Math.random() - 0.5) * 40,
      vx: 0,
      vy: 0,
      r: 4 + Math.min(n.degree, 8) * 1.1,
      color: `hsl(${hueFor(groups, n.group)}, 62%, 55%)`,
    }));
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const edges = raw.edges
      .map((e: any) => ({ a: byId.get(e.a), b: byId.get(e.b) }))
      .filter((e: any) => e.a && e.b) as { a: N; b: N }[];
    const adj = new Map<string, Set<string>>();
    for (const e of edges) {
      if (!adj.has(e.a.id)) adj.set(e.a.id, new Set());
      if (!adj.has(e.b.id)) adj.set(e.b.id, new Set());
      adj.get(e.a.id)!.add(e.b.id);
      adj.get(e.b.id)!.add(e.a.id);
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();

    // ---- interaction state ----
    let hover: N | null = null;
    let dragging: N | null = null;
    let panX = 0, panY = 0, panning = false, lastX = 0, lastY = 0;
    let alpha = 1; // simulation energy

    const toLocal = (ev: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      return { x: ev.clientX - rect.left - W / 2 - panX, y: ev.clientY - rect.top - H / 2 - panY };
    };
    const pick = (p: { x: number; y: number }) => {
      let best: N | null = null, bd = 14 * 14;
      for (const n of nodes) {
        const dx = n.x - p.x, dy = n.y - p.y, d = dx * dx + dy * dy;
        if (d < bd + n.r * n.r) { bd = d; best = n; }
      }
      return best;
    };

    function onMove(ev: PointerEvent) {
      const p = toLocal(ev);
      if (dragging) {
        dragging.x = p.x; dragging.y = p.y; dragging.vx = 0; dragging.vy = 0;
        alpha = Math.max(alpha, 0.3);
        return;
      }
      if (panning) {
        panX += ev.clientX - lastX; panY += ev.clientY - lastY;
        lastX = ev.clientX; lastY = ev.clientY;
        return;
      }
      const h = pick(p);
      if (h !== hover) { hover = h; canvas.style.cursor = h ? 'pointer' : 'grab'; }
    }
    function onDown(ev: PointerEvent) {
      canvas.setPointerCapture(ev.pointerId);
      const p = toLocal(ev);
      const n = pick(p);
      if (n) { dragging = n; }
      else { panning = true; lastX = ev.clientX; lastY = ev.clientY; }
    }
    function onUp(ev: PointerEvent) {
      const p = toLocal(ev);
      const n = pick(p);
      // treat as click if released on the same node without dragging far
      if (n && dragging === n) {
        const moved = Math.hypot(n.x - p.x, n.y - p.y);
        if (moved < 6) { location.href = n.href; }
      }
      dragging = null; panning = false;
      try { canvas.releasePointerCapture(ev.pointerId); } catch {}
    }

    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointerleave', () => { hover = null; });
    const onResize = () => { resize(); alpha = Math.max(alpha, 0.3); };
    window.addEventListener('resize', onResize);
    const onTheme = () => readTheme();
    window.addEventListener('theme-change', onTheme);

    // ---- simulation ----
    function step() {
      if (alpha > 0.005 && !dragging) {
        // repulsion (O(n²); n is small)
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            let dx = a.x - b.x, dy = a.y - b.y;
            let d2 = dx * dx + dy * dy || 0.01;
            const f = (2200 / d2) * alpha;
            const d = Math.sqrt(d2);
            const fx = (dx / d) * f, fy = (dy / d) * f;
            a.vx += fx; a.vy += fy; b.vx -= fx; b.vy -= fy;
          }
        }
        // springs
        for (const e of edges) {
          let dx = e.b.x - e.a.x, dy = e.b.y - e.a.y;
          const d = Math.hypot(dx, dy) || 0.01;
          const f = (d - 70) * 0.02 * alpha;
          const fx = (dx / d) * f, fy = (dy / d) * f;
          e.a.vx += fx; e.a.vy += fy; e.b.vx -= fx; e.b.vy -= fy;
        }
        // centering + integrate
        for (const n of nodes) {
          n.vx += -n.x * 0.0016 * alpha;
          n.vy += -n.y * 0.0016 * alpha;
          n.x += n.vx; n.y += n.vy;
          n.vx *= 0.85; n.vy *= 0.85;
        }
        alpha *= 0.992;
      }
      draw();
      raf = requestAnimationFrame(step);
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      ctx.save();
      ctx.translate(W / 2 + panX, H / 2 + panY);

      const near = hover ? adj.get(hover.id) ?? new Set<string>() : null;

      // edges
      ctx.lineWidth = 1;
      for (const e of edges) {
        const active = hover && (e.a.id === hover.id || e.b.id === hover.id);
        ctx.strokeStyle = active ? e.a.color : colEdge;
        ctx.globalAlpha = hover ? (active ? 0.9 : 0.12) : 0.35;
        ctx.beginPath();
        ctx.moveTo(e.a.x, e.a.y);
        ctx.lineTo(e.b.x, e.b.y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // nodes
      for (const n of nodes) {
        const dim = hover && n !== hover && !(near && near.has(n.id));
        ctx.globalAlpha = dim ? 0.25 : 1;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = n.color;
        ctx.fill();
        if (n === hover) {
          ctx.lineWidth = 2;
          ctx.strokeStyle = colCard;
          ctx.stroke();
        }
      }

      // labels: hubs always, neighbours + hovered on hover
      ctx.globalAlpha = 1;
      ctx.font = '12px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      for (const n of nodes) {
        const show =
          n === hover || (near && near.has(n.id)) || (!hover && n.degree >= 4);
        if (!show) continue;
        ctx.fillStyle = n === hover ? colText : colFaint;
        ctx.fillText(n.title, n.x, n.y + n.r + 3);
      }
      ctx.restore();
    }

    step();

    cleanup = () => {
      cancelAnimationFrame(raf);
      canvas.removeEventListener('pointermove', onMove);
      canvas.removeEventListener('pointerdown', onDown);
      canvas.removeEventListener('pointerup', onUp);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('theme-change', onTheme);
    };
  }

  document.addEventListener('astro:page-load', init);
</script>
