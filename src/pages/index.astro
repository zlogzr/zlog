---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, tagUrl } from '../lib/url';
import { AUTHOR } from '../lib/site';
import { formatDate } from '../lib/format';
import { getAllEntries, getSeries } from '../lib/collections';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPosts = allPosts.slice(0, 4);
const latestPost = allPosts[0];

const notes = await getCollection('notes', ({ data }) => !data.draft);
const categories = [...new Set(notes.map((n) => n.data.category))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);

// Series stats for the homepage.
const entries = await getAllEntries();
const series = getSeries(entries);
const featuredSeries = series.slice(0, 3);
const stats = [
  { n: allPosts.length, label: '篇文章' },
  { n: notes.length, label: '条笔记' },
  { n: series.length, label: '个系列' },
  { n: categories.length, label: '个分类' },
];
---

<BaseLayout>
  <section class="hero" data-reveal>
    <p class="eyebrow mono">// hello, world</p>
    <h1>你好，我是 <span class="name">zlog</span></h1>
    <p class="role">{AUTHOR.role}</p>
    <p class="bio">
      这里存放我踩过的坑、想明白的事，和还没想明白的问题。比起“怎么做”，我更愿意记录“为什么这么做”——
      那些藏在工程决策背后的权衡。
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={withBase('/posts')}>读读博客
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn" href={withBase('/about')}>关于我</a>
      <div class="socials" aria-label="社交链接">
        <a class="social" href={AUTHOR.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.36 9.36 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.91 0 1.38-.01 2.49-.01 2.83 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
        </a>
        <a class="social" href={withBase('/rss.xml')} aria-label="RSS 订阅" title="RSS">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="6.2" cy="17.8" r="1.8" fill="currentColor"/><path d="M4 11a9 9 0 0 1 9 9M4 5a15 15 0 0 1 15 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </a>
        <a class="social" href={`mailto:${AUTHOR.email}`} aria-label="发邮件" title="邮箱">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
    <div class="glow" aria-hidden="true"></div>
  </section>

  <section class="stats" data-reveal style="--reveal-delay: 60ms" aria-label="内容统计">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat-n mono">{s.n}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </section>

  <section class="cards" data-reveal style="--reveal-delay: 80ms">
    <a class="card" href={withBase('/posts')}>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2>博客</h2>
      <p class="card-desc">带时间线的文章与思考。</p>
      <p class="card-meta mono">
        {allPosts.length} 篇{latestPost && <> · 最新 {formatDate(latestPost.data.date)}</>}
      </p>
      <span class="card-foot">浏览全部 <span class="arrow">→</span></span>
    </a>

    <a class="card" href={withBase('/notes')}>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2>知识库</h2>
      <p class="card-desc">按主题沉淀、会反复修订的知识点。</p>
      <p class="card-meta mono">{notes.length} 条 · {categories.length} 个分类</p>
      <div class="cat-tags">
        {categories.slice(0, 6).map((c) => <span class="tag">{c}</span>)}
      </div>
      <span class="card-foot">浏览全部 <span class="arrow">→</span></span>
    </a>

    <a class="card" href={withBase('/series')}>
      <div class="card-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2>系列</h2>
      <p class="card-desc">把分散的内容串成有序的学习路径。</p>
      <p class="card-meta mono">{series.length} 条路径</p>
      <span class="card-foot">浏览全部 <span class="arrow">→</span></span>
    </a>
  </section>

  {featuredSeries.length > 0 && (
    <section class="featured" data-reveal style="--reveal-delay: 110ms">
      <div class="section-head">
        <h2>精选系列</h2>
        <a href={withBase('/series')} class="more">全部系列 →</a>
      </div>
      <div class="series-grid">
        {featuredSeries.map((s) => (
          <a class="series-card" href={withBase(`/series/${encodeURIComponent(s.name)}`)}>
            <div class="series-top">
              <span class="series-name">{s.name}</span>
              <span class="series-count mono">{s.items.length} 篇</span>
            </div>
            <ol class="series-mini">
              {s.items.slice(0, 3).map((e, i) => (
                <li>
                  <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
                  <span class="t">{e.title}</span>
                </li>
              ))}
            </ol>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="recent" data-reveal style="--reveal-delay: 140ms">
    <div class="section-head">
      <h2>最近写的</h2>
      <a href={withBase('/posts')} class="more">全部文章 →</a>
    </div>
    {recentPosts.length === 0 && (
      <p class="empty">还没有文章，去 <code>src/content/posts/</code> 写第一篇吧。</p>
    )}
    <ul class="post-list">
      {recentPosts.map((p) => (
        <li class="entry">
          <a class="entry-link" href={withBase(`/posts/${p.id}`)}>
            <time class="entry-date mono" datetime={p.data.date.toISOString()}>
              {formatDate(p.data.date)}
            </time>
            <span class="entry-title">{p.data.title}</span>
          </a>
          {p.data.tags.length > 0 && (
            <div class="entry-tags">
              {p.data.tags.slice(0, 3).map((t) => (
                <a class="tag" href={tagUrl(t)}>{t}</a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 5vw, 3rem) clamp(2.5rem, 6vw, 3.5rem);
  }
  .eyebrow {
    color: var(--accent);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    margin-bottom: 0.6rem;
  }
  .hero h1 {
    font-size: var(--step-4);
    margin: 0;
  }
  .hero .name {
    color: var(--accent);
  }
  .role {
    margin-top: 0.5rem;
    color: var(--text-soft);
    font-size: var(--step-1);
    font-weight: 500;
  }
  .bio {
    margin-top: 1.1rem;
    max-width: 36em;
    color: var(--text-soft);
    line-height: 1.85;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }
  .btn svg {
    transition: transform var(--dur) var(--ease);
  }
  .btn--primary:hover svg {
    transform: translateX(3px);
  }
  .socials {
    display: flex;
    gap: 0.3rem;
    margin-left: 0.3rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    color: var(--text-soft);
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .social:hover {
    color: var(--accent);
    background: var(--bg-subtle);
  }

  /* Soft depth behind the hero. */
  .glow {
    position: absolute;
    z-index: -1;
    top: -10%;
    left: -10%;
    width: 460px;
    height: 320px;
    max-width: 90%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
    filter: blur(20px);
    opacity: 0.7;
    pointer-events: none;
  }

  /* ---- Stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: var(--space-7);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.9rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .stat-n {
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
  }
  .stat-label {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  @media (max-width: 480px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---- Entry cards ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: var(--space-8);
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .card h2 {
    margin: 0;
    font-size: var(--step-1);
  }
  .card-desc {
    color: var(--text-soft);
    margin: 0.5rem 0 0.85rem;
    font-size: var(--step-0);
  }
  .card-meta {
    color: var(--text-faint);
    font-size: var(--step--1);
    margin: 0 0 0.85rem;
  }
  .cat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .card-foot {
    margin-top: auto;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 550;
  }
  .card .arrow {
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }
  .card:hover .arrow {
    transform: translateX(4px);
  }

  /* ---- Featured series ---- */
  .featured {
    margin-bottom: var(--space-8);
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .series-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .series-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
  .series-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .series-name {
    font-weight: 600;
    font-size: var(--step-0);
  }
  .series-card:hover .series-name {
    color: var(--accent);
  }
  .series-count {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: var(--text-faint);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0 0.5rem;
    line-height: 1.7;
  }
  .series-mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .series-mini li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .series-mini .idx {
    color: var(--text-faint);
    font-size: 0.7rem;
    flex-shrink: 0;
  }
  .series-mini .t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- Recent list ---- */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .section-head h2 {
    margin: 0;
    font-size: var(--step-2);
  }
  .more {
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .more:hover {
    color: var(--accent);
  }
  .empty {
    color: var(--text-soft);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list .entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-block: 0.95rem;
  }
  .entry-link {
    display: flex;
    align-items: baseline;
    gap: 0.95rem;
    color: var(--text);
    min-width: 0;
    flex: 1;
  }
  .entry-date {
    flex-shrink: 0;
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .entry-title {
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }
  .entry-link:hover .entry-title {
    color: var(--accent);
  }
  .entry-tags {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  @media (max-width: 520px) {
    .entry-tags {
      display: none;
    }
  }
</style>
