---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase, tagUrl } from '../../lib/url';
import { formatDate, isoDateTime, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} description={`「${tag}」标签下的全部文章`}>
  <div class="page-head">
    <p class="crumb mono">
      <a href={withBase('/tags')}>// tags</a> / {tag}
    </p>
    <h1>#{tag}</h1>
    <p class="lede">共 {posts.length} 篇文章。</p>
  </div>

  <ul class="entries">
    {posts.map((p) => (
      <li class="entry" data-reveal>
        <div class="entry-meta mono">
          <time datetime={isoDateTime(p.data.date)}>{formatDate(p.data.date)}</time>
          <span class="sep">·</span>
          <span>{readingTime(p.body ?? '')} 分钟</span>
        </div>
        <h3><a href={withBase(`/posts/${p.id}`)}>{p.data.title}</a></h3>
        {p.data.description && <p class="excerpt">{p.data.description}</p>}
        {p.data.tags.length > 0 && (
          <div class="entry-tags">
            {p.data.tags.map((t) => (
              <a class:list={['tag', { current: t === tag }]} href={tagUrl(t)}>{t}</a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>

  <a class="back" href={withBase('/tags')}><span class="arrow">←</span> 全部标签</a>
</BaseLayout>

<style>
  .crumb {
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .crumb a {
    color: var(--text-soft);
  }
  .crumb a:hover {
    color: var(--accent);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .entry-meta .sep {
    color: var(--border-strong);
  }
  .entry h3 {
    margin: 0.4rem 0 0;
    font-size: var(--step-1);
  }
  .entry h3 a {
    color: var(--text);
  }
  .entry h3 a:hover {
    color: var(--accent);
  }
  .excerpt {
    margin: 0.45rem 0 0;
    color: var(--text-soft);
  }
  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }
  .tag.current {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
